<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SpoilerFilme</title>
  <style>
    /* Reset de margem e padding */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background-color: #f4f4f4;
      color: #000;
    }

    /* Cabeçalho */
    header {
      background-color: #8a2be2; /* Roxo */
      color: #fff;
      padding: 15px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    header h1 {
      font-size: 24px;
    }

    /* Ícones do canto direito */
    .icons {
      display: flex;
      gap: 15px;
    }

    .icons a {
      color: #fff;
      text-decoration: none;
      font-size: 20px;
    }

    /* Menu de categorias */
 nav {
  background-color: #000;       
  padding: 15px 30px;           
  display: flex;                 
  justify-content: space-between;
  align-items: center;           
}

nav a {
  color: #fff;                  
  text-decoration: none;         
  font-weight: bold;             
  font-size: 16px;               
  transition: color 0.3s ease;   
}

nav a:hover {
  color: #ffcc00;                
}

    /* Título seção */
    h2 {
      text-align: center;
      margin: 20px 0;
    }

    /* Cards de filmes */
    .filmes {
  display: flex;
  justify-content: center;
  gap: 60px;              
  flex-wrap: wrap;
  margin: 40px 20px;      
}

.filme {
  text-align: center;
  width: 220px;           
}

.filme img {
  width: 220px;           
  height: 330px;
  border: 3px solid #000; 
  border-radius: 12px;    
  cursor: pointer;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.filme img:hover {
  transform: scale(1.08);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
}

.filme a {
  text-decoration: none;
  color: #000;
  display: block;
  margin-top: 12px;
  font-weight: bold;
  font-size: 16px;
}


  </style>
</head>
<body>
  <!-- Cabeçalho -->
  <header>
    <h1>spoilerfilme</h1>
    <div class="icons">
      <!-- Ícones (poderia trocar por imagens/font-awesome) -->
      <a href="#">⭐</a>
      <a href="#">👤</a>
    </div>
  </header>

  <!-- Menu de categorias -->
  <nav>
    <a href="#">Terror</a>
    <a href="#">Comédia</a>
    <a href="#">Romance</a>
    <a href="#">Ação</a>
    <a href="#">Ficção Científica</a>
  </nav>

  <!-- Título seção -->
  <h2>Filmes mais lidos</h2>

  <!-- Galeria de filmes -->
  <section class="filmes">
    <div class="filme">
      <a href="#">
        <img src="https://upload.wikimedia.org/wikipedia/pt/1/1d/Harry_Potter_Pedra_Filosofal_2001.jpg" alt="Filme 1">
        Harry_Potter_Pedra 
        Filosofal_2001
      </a>
    </div>
    <div class="filme">
      <a href="#">
        <img src="https://maesdeplantao.wordpress.com/wp-content/uploads/2012/06/enrolados-dvd-blu-ray-topo.jpg" alt="Filme 2">
        enrolados
      </a>
    </div>
    <div class="filme">
      <a href="#">
        <img src="https://cinemagia.wordpress.com/wp-content/uploads/2015/06/divertida-mente1.jpg" alt="Filme 3">
        divertida-mente1
      </a>
    </div>
  </section>
</body>
</html>
